# BD Solar Energy — Frontend Environment Configuration Example
# Copy this file to .env and configure with your local or production settings.

# Backend REST API Base URL
# Local development with Vite proxy: /api/v1
# Direct backend communication: http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=/api/v1

# Google OAuth2 Client ID (Optional / For Google Social Login)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
