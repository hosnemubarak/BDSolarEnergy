# BD Solar Energy — Environment Configuration
# Copy this file to .env in production and update the values.

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=bdsolarenergy.com,www.bdsolarenergy.com,api.bdsolarenergy.com,localhost,127.0.0.1

# Database (PostgreSQL recommended in production)
# Leave unset or empty to use default local SQLite db.sqlite3
DATABASE_URL=postgres://bd_solar_user:db_password@localhost:5432/bdsolar_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://bdsolarenergy.com,https://www.bdsolarenergy.com,http://localhost:5173

# SSL & Security (Active when DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Media and Static Storage
MEDIA_URL=/media/
STATIC_URL=/static/
