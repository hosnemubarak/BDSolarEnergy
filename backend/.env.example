# BD Solar Energy — Backend Environment Configuration Example
# Copy this file to .env and configure with your environment values.

# Security & Django Core
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=bdsolarenergy.com,www.bdsolarenergy.com,api.bdsolarenergy.com,localhost,127.0.0.1

# Database (PostgreSQL recommended in production)
DB_NAME=bdsolar_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgres://postgres:your_secure_db_password@localhost:5432/bdsolar_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://bdsolarenergy.com,https://www.bdsolarenergy.com,http://localhost:5173,http://localhost:5174

# Google OAuth2 Social Authentication (Optional / Activation Ready)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://bdsolarenergy.com/auth/google/callback

# SSL & Production Security (Active when DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Media and Static Storage
MEDIA_URL=/media/
STATIC_URL=/static/
